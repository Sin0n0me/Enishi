@echo off
@rem Generated by generate_build.py. Do not edit this file directly.
setlocal EnableExtensions
set "PROJECT_ROOT=%~dp0.."
set "SOURCE_DIR=%PROJECT_ROOT%\src"

set "BACKEND=%~1"
set "CONFIG=%~2"
set "TOOLCHAIN=%~3"
if "%BACKEND%"=="" goto :usage
if "%CONFIG%"=="" set "CONFIG=Debug"
if "%TOOLCHAIN%"=="" set "TOOLCHAIN=auto"
if not defined CMAKE_BUILD_PARALLEL_LEVEL set "CMAKE_BUILD_PARALLEL_LEVEL=%NUMBER_OF_PROCESSORS%"
if not defined CMAKE_BUILD_PARALLEL_LEVEL set "CMAKE_BUILD_PARALLEL_LEVEL=2"
if defined PYTHON_EXECUTABLE set "PYTHON_OPTIONS="-DPython_EXECUTABLE=%PYTHON_EXECUTABLE%" "-DPython3_EXECUTABLE=%PYTHON_EXECUTABLE%""
if /I "%BACKEND%"=="opengl" set "BACKEND_OPTIONS=-DUSE_OPENGL40=ON -DUSE_VULKAN=OFF"
if /I "%BACKEND%"=="directx" set "BACKEND_OPTIONS=-DUSE_OPENGL40=OFF -DUSE_VULKAN=OFF"
if /I "%BACKEND%"=="vulkan" set "BACKEND_OPTIONS=-DUSE_OPENGL40=OFF -DUSE_VULKAN=ON"
if "%BACKEND_OPTIONS%"=="" goto :usage
if /I "%TOOLCHAIN%"=="auto" goto :auto
if /I "%TOOLCHAIN%"=="visualstudio" goto :visualstudio
if /I "%TOOLCHAIN%"=="clang" goto :clang
if /I "%TOOLCHAIN%"=="gcc" goto :gcc
goto :usage

:auto
set "AUTO_FALLBACK=ON"
goto :visualstudio
:visualstudio
set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
if not exist "%VSWHERE%" goto :visualstudio_unavailable
"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -version "[18.0,19.0)" -property installationPath | findstr.exe /r /c:"." >nul
if not errorlevel 1 set "GENERATOR=Visual Studio 18 2026"
if not defined GENERATOR "%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -version "[17.0,18.0)" -property installationPath | findstr.exe /r /c:"." >nul
if not defined GENERATOR if not errorlevel 1 set "GENERATOR=Visual Studio 17 2022"
if not defined GENERATOR goto :visualstudio_unavailable
set "BUILD_DIR=%~dp0%BACKEND%\visualstudio"
set "DEFAULT_TRIPLET=x64-windows"
goto :build_visualstudio
:visualstudio_unavailable
if /I "%AUTO_FALLBACK%"=="ON" goto :clang
echo Visual Studio 18 2026 or Visual Studio 17 2022 was not found.
exit /b 1
:clang
where.exe ninja >nul 2>nul || goto :clang_unavailable
where.exe clang >nul 2>nul || goto :clang_unavailable
set "BUILD_DIR=%~dp0%BACKEND%\clang"
set "DEFAULT_TRIPLET=x64-windows"
set "COMPILER_OPTIONS=-DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++"
goto :build_ninja
:clang_unavailable
if /I "%AUTO_FALLBACK%"=="ON" goto :gcc
echo Clang or Ninja was not found.
exit /b 1
:gcc
where.exe ninja >nul 2>nul || goto :gcc_unavailable
where.exe gcc >nul 2>nul || goto :gcc_unavailable
where.exe g++ >nul 2>nul || goto :gcc_unavailable
set "BUILD_DIR=%~dp0%BACKEND%\gcc"
set "DEFAULT_TRIPLET=x64-mingw-dynamic"
set "COMPILER_OPTIONS=-DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++"
goto :build_ninja
:gcc_unavailable
echo GCC or Ninja was not found.
exit /b 1

:configure_packages
set "PACKAGE_OPTIONS="
if defined CMAKE_TOOLCHAIN_FILE set "PACKAGE_OPTIONS="-DCMAKE_TOOLCHAIN_FILE=%CMAKE_TOOLCHAIN_FILE%""
if defined VCPKG_INSTALLED_DIR set "PACKAGE_OPTIONS=%PACKAGE_OPTIONS% -DVCPKG_INSTALLED_DIR=%VCPKG_INSTALLED_DIR%"
if defined VCPKG_TARGET_TRIPLET set "PACKAGE_OPTIONS=%PACKAGE_OPTIONS% -DVCPKG_TARGET_TRIPLET=%VCPKG_TARGET_TRIPLET%"
if defined CMAKE_TOOLCHAIN_FILE exit /b 0
if not defined VCPKG_ROOT if defined VCPKG_INSTALLATION_ROOT set "VCPKG_ROOT=%VCPKG_INSTALLATION_ROOT%"
if not defined VCPKG_ROOT for /f "delims=" %%I in ('where.exe vcpkg.exe 2^>nul') do if not defined VCPKG_ROOT for %%J in ("%%I") do set "VCPKG_ROOT=%%~dpJ"
if not defined VCPKG_ROOT goto :vcpkg_missing
set "VCPKG_TOOLCHAIN=%VCPKG_ROOT%\scripts\buildsystems\vcpkg.cmake"
if not exist "%VCPKG_TOOLCHAIN%" goto :vcpkg_missing
if not defined VCPKG_TARGET_TRIPLET set "VCPKG_TARGET_TRIPLET=%DEFAULT_TRIPLET%"
set "PACKAGE_OPTIONS="-DCMAKE_TOOLCHAIN_FILE=%VCPKG_TOOLCHAIN%" -DVCPKG_TARGET_TRIPLET=%VCPKG_TARGET_TRIPLET%"
if defined VCPKG_INSTALLED_DIR set "PACKAGE_OPTIONS=%PACKAGE_OPTIONS% -DVCPKG_INSTALLED_DIR=%VCPKG_INSTALLED_DIR%"
exit /b 0
:vcpkg_missing
echo vcpkg was not found. Set VCPKG_ROOT or CMAKE_TOOLCHAIN_FILE.
exit /b 1

:configure_build
if defined ENISHI_BUILD_DIR set "BUILD_DIR=%ENISHI_BUILD_DIR%"
set "BUILD_OPTIONS="
if defined ENISHI_OFFLINE set "BUILD_OPTIONS=-DFETCHCONTENT_FULLY_DISCONNECTED=OFF -DFETCHCONTENT_UPDATES_DISCONNECTED=OFF -DVCPKG_MANIFEST_INSTALL=ON"
if "%ENISHI_OFFLINE%"=="1" set "BUILD_OPTIONS=-DFETCHCONTENT_FULLY_DISCONNECTED=ON -DFETCHCONTENT_UPDATES_DISCONNECTED=ON -DVCPKG_MANIFEST_INSTALL=OFF"
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY=%ENISHI_ARTIFACT_DIR%""
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG=%ENISHI_ARTIFACT_DIR%""
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE=%ENISHI_ARTIFACT_DIR%""
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_LIBRARY_OUTPUT_DIRECTORY=%ENISHI_ARTIFACT_DIR%""
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_LIBRARY_OUTPUT_DIRECTORY_DEBUG=%ENISHI_ARTIFACT_DIR%""
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE=%ENISHI_ARTIFACT_DIR%""
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_PDB_OUTPUT_DIRECTORY=%ENISHI_ARTIFACT_DIR%""
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_PDB_OUTPUT_DIRECTORY_DEBUG=%ENISHI_ARTIFACT_DIR%""
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_PDB_OUTPUT_DIRECTORY_RELEASE=%ENISHI_ARTIFACT_DIR%""
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_ARCHIVE_OUTPUT_DIRECTORY=%BUILD_DIR%/lib""
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_ARCHIVE_OUTPUT_DIRECTORY_DEBUG=%BUILD_DIR%/lib""
if defined ENISHI_ARTIFACT_DIR set "BUILD_OPTIONS=%BUILD_OPTIONS% "-DCMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE=%BUILD_DIR%/lib""
exit /b 0

:build_visualstudio
call :configure_build
call :configure_packages
if errorlevel 1 exit /b %errorlevel%
cmake -S "%SOURCE_DIR%" -B "%BUILD_DIR%" -G "%GENERATOR%" %BACKEND_OPTIONS% %PACKAGE_OPTIONS% %PYTHON_OPTIONS% %BUILD_OPTIONS%
if errorlevel 1 exit /b %errorlevel%
@rem Share the compiler process limit across projects as well as parallelizing projects.
cmake --build "%BUILD_DIR%" --target enishi_engine --config "%CONFIG%" --parallel "%CMAKE_BUILD_PARALLEL_LEVEL%" -- /p:UseMultiToolTask=true /p:EnforceProcessCountAcrossBuilds=true /p:MultiProcMaxCount=%CMAKE_BUILD_PARALLEL_LEVEL%
exit /b %errorlevel%
:build_ninja
call :configure_build
call :configure_packages
if errorlevel 1 exit /b %errorlevel%
cmake -S "%SOURCE_DIR%" -B "%BUILD_DIR%" -G Ninja %BACKEND_OPTIONS% %PACKAGE_OPTIONS% %COMPILER_OPTIONS% %PYTHON_OPTIONS% %BUILD_OPTIONS% -DCMAKE_BUILD_TYPE=%CONFIG%
if errorlevel 1 exit /b %errorlevel%
cmake --build "%BUILD_DIR%" --target enishi_engine --parallel "%CMAKE_BUILD_PARALLEL_LEVEL%"
exit /b %errorlevel%
:usage
echo Usage: %~nx0 ^<opengl^|directx^|vulkan^> [config] [auto^|visualstudio^|clang^|gcc]
exit /b 1
