execute_process(COMMAND "${EXECUTABLE}" "${MODE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 10)
if(MODE STREQUAL "success")
    if(NOT status STREQUAL "0" OR NOT diagnostic MATCHES "\\[PASS\\] diagnostic_probe")
        message(FATAL_ERROR "Success probe failed (${status}): ${output}${diagnostic}")
    endif()
else()
    if(NOT status STREQUAL "1")
        message(FATAL_ERROR "Expected normal failure exit 1, got ${status}: ${diagnostic}")
    endif()
    foreach(expected IN LISTS EXPECTED)
        string(FIND "${diagnostic}" "${expected}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Missing '${expected}': ${diagnostic}")
        endif()
    endforeach()
endif()
